# Get your key at https://resend.com → API Keys
RESEND_API_KEY=re_your_key_here

# --- Booking funnel (all NEXT_PUBLIC_* values are public and read at build time: redeploy after changing) ---
# Your Calendly event link. Leave empty until you have it; the page then shows a clear "booking not switched on" message.
NEXT_PUBLIC_CALENDLY_URL=
# The overview video. Set ONE of these; the embed URL wins if both are set. Leave both empty to show the placeholder.
# Embed URL from YouTube / Vimeo / Loom / Wistia (autoplay is stripped):
NEXT_PUBLIC_VSL_EMBED_URL=
# ...or a direct https link to a video file you host (.mp4 / .webm), with an optional poster image:
NEXT_PUBLIC_VSL_VIDEO_URL=
NEXT_PUBLIC_VSL_POSTER_URL=

# --- Where lead emails go (server-only: no NEXT_PUBLIC_ prefix, so these never reach the browser) ---
# Leave both unset to keep the defaults (your Resend account email, sent from Resend's test address).
# To get notifications at another address, first verify your domain in Resend (resend.com -> Domains),
# then set BOTH of these in Vercel and redeploy. Setting only the first one makes Resend refuse the send.
LEAD_NOTIFY_EMAIL=
RESEND_FROM_EMAIL=
